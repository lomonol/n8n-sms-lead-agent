    {
      "id": "d86bf230-1230-4b7d-8795-7ee4297596c7",
      "name": "SMS agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        2160,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Now: {{ $now.setZone($('Get settings').first().json.timezone).toFormat('cccc d LLL yyyy HH:mm') }}\nLead: name={{ $('Get lead').first().json.name }}; status={{ $('Get lead').first().json.status }}; job_type={{ $('Get lead').first().json.job_type }}; suburb={{ $('Get lead').first().json.suburb }}; urgency={{ $('Get lead').first().json.urgency }}; booked_at={{ $('Get lead').first().json.booked_at }}\nHistory:\n{{ $json.lines.join('\\n') }}\nNew text: {{ $('From inbound').first().json.body }}",
        "hasOutputParser": true,
        "options": {
          "maxIterations": 6,
          "systemMessage": "=You are the SMS assistant for {{ $('Get profile').first().json.business_name }}. Reply as the business, by text message.\nServices: {{ $('Get profile').first().json.services }}\nService area: {{ $('Get profile').first().json.service_area }}\nHours: {{ $('Get profile').first().json.hours }}\nBooking rules: {{ $('Get profile').first().json.booking_rules }}\nPrice policy: {{ $('Get profile').first().json.price_policy }}\nHandoff rules: {{ $('Get profile').first().json.handoff_rules }}\nTone: {{ $('Get profile').first().json.tone }}\n\nRules:\n- Reply in at most 2 sentences and 300 characters.\n- Ask one question at a time to learn job_type, suburb, urgency and the customer's name.\n- Only offer times that the check_slot tool says are free and that are inside the business hours.\n- Call book_slot only after the customer has agreed a time.\n- Call update_lead whenever you learn a detail.\n- Never invent prices, policies or availability.\n- Set risk to true for price, complaint, refund, cancellation, safety or legal topics, or if you are unsure."
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "71eae971-ad8f-4910-b032-de63820e0cb8",
      "name": "Chat model",
