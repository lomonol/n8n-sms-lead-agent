            "suburb": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('suburb', 'Suburb of the job') }}",
            "urgency": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('urgency', 'How urgent the job is') }}"
          },
          "matchingColumns": [],
          "schema": []
        }
      }
    },
    {
      "id": "197e2214-2c7b-484c-9e79-24605981ef08",
      "name": "Reply format",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        2700,
        700
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"reply\":{\"type\":\"string\"},\"intent\":{\"type\":\"string\",\"enum\":[\"enquiry\",\"qualify\",\"book\",\"reschedule\",\"cancel\",\"price\",\"complaint\",\"handoff\",\"off_topic\",\"other\"]},\"risk\":{\"type\":\"boolean\"},\"risk_reason\":{\"type\":\"string\"},\"confidence\":{\"type\":\"number\",\"minimum\":0,\"maximum\":1},\"booked_start\":{\"type\":[\"string\",\"null\"]}},\"required\":[\"reply\",\"intent\",\"risk\",\"risk_reason\",\"confidence\",\"booked_start\"]}",
        "autoFix": true
      }
    },
    {
      "id": "28bed962-8759-41cc-b019-8a4c7b8c8985",
      "name": "Fallback reply",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        2480,
        500
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "body",
              "type": "string",
              "value": "=Thanks for your message, someone from {{ $('Get profile').first().json.business_name }} will text you back shortly."
            },
            {
              "id": "f2",
              "name": "kind",
              "type": "string",
              "value": "fallback"
            },
            {
              "id": "f3",
              "name": "risky",
              "type": "boolean",
              "value": true
            },
            {
              "id": "f4",
              "name": "risk_reason",
              "type": "string",
              "value": "=agent error: {{ $json.error?.message ?? $json.error ?? 'unknown' }}"
            },
            {
              "id": "f5",
              "name": "intent",
              "type": "string",
              "value": "other"
            }
          ]
        },
        "includeOtherFields": false
      }
    },
    {
      "id": "cb951e63-e8dd-4fc5-aeb1-3d22f4454faf",
      "name": "Risk gate",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        2480,
        200
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "r1",
              "name": "risky",
              "type": "boolean",
              "value": "={{ $json.output.risk || $json.output.confidence < $('Get settings').first().json.confidence_floor || ['price','complaint','cancel','reschedule','handoff'].includes($json.output.intent) || $json.output.reply.length > 300 }}"
            },
            {
              "id": "r2",
              "name": "risk_reason",
              "type": "string",
              "value": "={{ $json.output.risk_reason || ('rule: ' + $json.output.intent) }}"
            },
            {
              "id": "r3",
              "name": "new_status",
              "type": "string",
              "value": "={{ $json.output.booked_start ? 'booked' : (['complaint','handoff','cancel'].includes($json.output.intent) ? 'handoff' : 'qualifying') }}"
            }
          ]
        },
        "includeOtherFields": true
      }
    },
    {
      "id": "e4550d30-a134-4771-9c6a-5684d0a1fbd1",
