    {
      "id": "5c8f223e-5e48-4414-ae5e-0d97e21e327e",
      "name": "check_slot",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [
        2100,
        700
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Check if a time slot is free.",
        "resource": "calendar",
        "operation": "availability",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Get settings').first().json.calendar_id }}"
        },
        "timeMin": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('start', 'ISO start time') }}",
        "timeMax": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('end', 'ISO end time') }}",
        "options": {
          "timezone": {
            "__rl": true,
            "mode": "id",
            "value": "={{ $('Get settings').first().json.timezone }}"
          }
        }
      },
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "id": "580d3837-5367-49ac-af78-35fd983b3fe9",
      "name": "book_slot",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [
        2300,
        700
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Book an agreed slot.",
        "resource": "event",
        "operation": "create",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Get settings').first().json.calendar_id }}"
        },
        "start": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('start', 'ISO start time') }}",
        "end": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('end', 'ISO end time') }}",
        "additionalFields": {
          "summary": "=Quote visit: {{ $fromAI('customer_name', 'Customer name', 'string') }} ({{ $('From inbound').first().json.phone }})",
          "description": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('notes', 'Short notes about the job') }}"
        }
      },
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Google Calendar account"
        }
      }
