      "name": "Inbound SMS",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        0,
        288
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "sms-inbound",
        "authentication": "headerAuth",
        "responseMode": "responseNode"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "SMS Webhook Token"
        }
      }
    },
    {
      "id": "42b1c0f9-46d4-487f-9779-17b7df87532a",
      "name": "Ack provider",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        224,
        288
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "<Response></Response>",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/xml"
              }
            ]
          }
        }
      }
    },
    {
      "id": "94eb6cf8-1a05-473d-ab41-7eedf43915fe",
      "name": "Normalise",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        448,
        288
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "phone",
              "value": "={{ ($json.body.From ?? '').replace(/[\\s()-]/g, '') }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "body",
              "value": "={{ ($json.body.Body ?? '').trim() }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "body_upper",
              "value": "={{ ($json.body.Body ?? '').trim().toUpperCase() }}",
              "type": "string"
            },
            {
              "id": "a4",
              "name": "test_label",
              "value": "={{ $json.body.test_label ?? '' }}",
              "type": "string"
            },
            {
              "id": "a5",
              "name": "received_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false
      }
    },
    {
      "id": "859348b7-68ef-4a23-90a9-e9e14d50695a",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        672,
        288
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.phone }}",
              "operator": {
                "type": "string",
                "operation": "regex"
              },
              "rightValue": "^\\+\\d{8,15}$"
            },
            {
              "leftValue": "={{ $json.body }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "1cf37352-a911-4486-b62a-b8cc2b569f2a",
