    {
      "id": "71a41753-0afb-4a3e-bcd8-9d9b82fb9ca3",
      "name": "Is STOP?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1344,
        192
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ ['STOP','STOP ALL','UNSUBSCRIBE','END','QUIT'].includes($('Normalise').item.json.body_upper) }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
